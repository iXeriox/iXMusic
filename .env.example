# Existing PHP API directory. Relative /api keeps the same-origin database connection.
VITE_API_BASE_URL=/api
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/

# Server environment (never expose the secret through Vite)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:5173/
